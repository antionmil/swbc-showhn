node_modules
.next
# Every env file, however it is named — `.env` and `.env.local` alone miss
# `.env.production` and `.env.*.local`, exactly the file created in a hurry.
.env*
!.env.example
.vercel
*.tsbuildinfo
next-env.d.ts
.next-build

# Built by `pnpm data` from data/*.jsonl on every build. Committing them would
# ship yesterday's numbers next to today's corpus.
/src/data/*.json
/public/data/*.json
/data/search.txt
