{
  "name": "showhn-what-worked",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "scripts": {
    "dev": "NODE_OPTIONS=--max-old-space-size=2048 next dev",
    "build": "pnpm data && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "data": "tsx scripts/build-data.mts",
    "test": "node --import tsx --test qa/*.test.mts",
    "build:check": "NEXT_DIST_DIR=.next-build next build",
    "refresh": "tsx scripts/fetch-new.mts"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
